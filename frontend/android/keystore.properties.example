# Copy to keystore.properties (git ignores it) and fill in. Make the upload
# key once with:
#   keytool -genkey -v -keystore ~/levy-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias levy-upload
# Keep the .jks and these passwords somewhere safe outside the repo: Google
# Play App Signing holds the real signing key, and a lost upload key can be
# reset through Play Console support, but it takes days.
storeFile=/Users/you/levy-upload.jks
storePassword=
keyAlias=levy-upload
keyPassword=
