# Levy backend configuration.
#
# Copy to backend/.env and fill in. Every value here is a PLACEHOLDER — never
# commit a real key. In production these live in the Railway environment for
# the `levy-api` project (id f3d53460-8d02-43f8-b71c-6943d2facb3c), NOT in a
# file. Set them from the backend/ directory so the CLI targets the right
# project, and pipe secrets from the clipboard so they never reach your shell
# history:
#
#     cd backend && pbpaste | railway variable set --stdin SOME_KEY
#
# ── Required: nothing works without these ────────────────────────────────────

# Supabase (Postgres + pgvector + auth). The backend uses the SERVICE key,
# which bypasses RLS; the frontend uses the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Anthropic — the chat model.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — embeddings ONLY (text-embedding-3-small at 768 dims). The entire
# corpus is embedded with this provider and there is no compatible fallback:
# switching providers means re-embedding everything. If this key runs out of
# quota, corpus search fails silently while chat keeps answering, so monitor
# /health/embeddings, not just /health/llm.
OPENAI_API_KEY=sk-...

# ── Optional: features degrade gracefully without these ──────────────────────

# Tavily — web search, used when the corpus has no answer.
TAVILY_API_KEY=tvly-...

# Laws.Africa Content API — legislation + judgments ingestion.
# Content is CC-BY-NC-SA (non-commercial).
LAWS_AFRICA_API_TOKEN=

# Cloudflare Turnstile SECRET key (the SITE key is public and belongs in the
# frontend as NEXT_PUBLIC_TURNSTILE_SITE_KEY). FAILS CLOSED: while this is
# empty, anonymous chat stays blocked and everyone must sign in. A missing or
# mistyped value can only keep the door shut, never open it.
TURNSTILE_SECRET_KEY=

# Moonshot (Kimi) — the CROSS-VENDOR fallback. Every other model in the chain
# is an Anthropic model behind one account and one rate limit, so an Anthropic
# outage takes Levy down entirely; Kimi runs on different infrastructure.
# Empty = the fallback is never attempted (a Claude-only chain, which is a
# valid deployment). Verify it is armed with /health/fallback.
#
# This is a RESILIENCE lever, not a cost one: benchmarked on Levy's real
# workload Kimi cost MORE per turn than Claude. See services/kimi.py.
MOONSHOT_API_KEY=

# Primary agent model. Empty = the default in services/agent.py
# (claude-sonnet-4-6). Set to claude-haiku-4-5 to run the cheaper tier and
# measure it against the answer-feedback signal. Both services/agent.py and
# providers/anthropic_provider.py read this, so /health/llm always reports
# the model that is actually serving users.
AGENT_MODEL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Two DELIBERATELY SEPARATE tokens, so a reporting job never holds delete
# rights. Both endpoints are disabled entirely while their token is empty.

# Gates destructive admin endpoints (e.g. /artifacts/sweep).
ADMIN_API_TOKEN=

# Gates the read-only aggregate stats endpoint (/api/admin/feedback-stats),
# used by the scheduled model-A/B reports. Returns counts only — never
# message content or written feedback.
ADMIN_STATS_TOKEN=
